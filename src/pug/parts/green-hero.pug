section.section-integrations.green-hero
  .container 
    .integrations 
      .integrations__left
        p.eyebrow DEVELOPER PORTAL 
          span.eyebrow__accent ( ©2025 )
        .integrations__subtext
          h1.heading__h1 
            span.heading__h1__accent Developers 
            | — API Reference & 
