section.section-need.need-green 
  .container 
    .need 
      .need__head 
        p.eyebrow 
          span.eyebrow__accent Everything You Need 
          | to Build
        h2.heading__h2 
          span.heading__h2__accent Discover the technical components, 
          | documentation, and simulators that support your integration from start to finish.
      .need__wrapper 
        .need__grid 
          .need__flex 
            .need__card 
              .need__card__content 
                img(src='../../assets/images/need__card-api-2.webp', alt='Deskripsi gambar')
                .need__card__body 
                  h3.need__card__title API reference
                  p.need__card__summary Endpoints for parties, accounts, instructions, settlements, and cases.
              img.need__card__bg(src='../../assets/images/need__card_bg-api-2.webp', alt='Deskripsi gambar')
          .need__flex 
            .need__card 
              .need__card__content 
                img(src='../../assets/images/need__card-sdk-2.webp', alt='Deskripsi gambar')
                .need__card__body 
                  h3.need__card__title SDKs (roadmap)
                  p.need__card__summary TypeScript, Python.
              img.need__card__bg(src='../../assets/images/need__card_bg-sdk-2.webp', alt='Deskripsi gambar')
            .need__card 
              .need__card__content 
                img(src='../../assets/images/need__card-event-2.webp', alt='Deskripsi gambar')
                .need__card__body 
                  h3.need__card__title Events
                  p.need__card__summary Webhooks for status changes and exception handling.
              img.need__card__bg(src='../../assets/images/need__card_bg-event-2.webp', alt='Deskripsi gambar')
          .need__flex 
            .need__card 
              .need__card__content 
                img(src='../../assets/images/need__card-quick-2.webp', alt='Deskripsi gambar')
                .need__card__body 
                  h3.need__card__title Quickstarts
                  p.need__card__summary Payouts, collections, onboarding, sanctions checks, and transaction monitoring pipelines.
              img.need__card__bg(src='../../assets/images/need__card_bg-quick-2.webp', alt='Deskripsi gambar')
            .need__card 
              .need__card__content 
                img(src='../../assets/images/need__card-test-2.webp', alt='Deskripsi gambar')
                .need__card__body 
                  h3.need__card__title Test data & simulators
                  p.need__card__summary Corridors, cutoffs, and exception paths.
              img.need__card__bg(src='../../assets/images/need__card_bg-test-2.webp', alt='Deskripsi gambar')
        img.need__ornament(src='../../assets/images/need__ornament__small-2.webp', alt='Deskripsi gambar')
    .need__overlay
      img(src='../../assets/images/need__tagline-green.webp', alt='Deskripsi gambar')