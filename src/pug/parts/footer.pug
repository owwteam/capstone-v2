mixin footer(bgClass, imgSrc)
  footer.footer(class=bgClass) 
    .container
      .footer__wrapper 
        .footer__menus 
          a.footer__link(href="/") Blue page
          a.footer__link(href="purplepage.html") Purple Page with GIrl
          a.footer__link(href="greenpage.html") Green Page with human figure
          a.footer__link(href="orangepage.html") New Orange Page
          a.footer__link(href="job-portal-login.html") Job Portal (login)
        .footer__tagline
          img.footer__tagline__img(src=imgSrc, alt='Deskripsi gambar')